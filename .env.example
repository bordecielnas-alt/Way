# Copy to .env, then: docker compose up -d --build

# Required
POSTGRES_PASSWORD=change-me

# Wikimedia asks API clients for a contact in their User-Agent (email or URL).
WAY_CONTACT=

# Prebuilt images (GitHub Packages). WAY_TAG: latest, a short commit sha, or a version.
WAY_IMAGE_PREFIX=ghcr.io/bordecielnas-alt/way
WAY_TAG=latest

# Host port for the web app
WAY_PORT=8080

# Search tuning (see packages/core/src/config.ts)
WORKER_CONCURRENCY=2
GLOBAL_MIN_SITELINKS=5
GLOBAL_LIMIT=1200

# Optional satellite basemap (defaults to Esri World Imagery; check its terms of use)
VITE_SATELLITE_URL=
VITE_SATELLITE_CREDIT=
