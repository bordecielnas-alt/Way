<?xml version="1.0"?>
<Container version="2">
  <Name>way</Name>
  <Repository>ghcr.io/bordecielnas-alt/way:latest</Repository>
  <Registry>https://github.com/bordecielnas-alt/Way/pkgs/container/way</Registry>
  <Network>bridge</Network>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/bordecielnas-alt/Way</Support>
  <Project>https://github.com/bordecielnas-alt/Way</Project>
  <Overview>Globe historique explorable : 7 000 ans d'histoire, faits sourcés (Wikidata, Wikipédia), frontières historiques.</Overview>
  <Category>Other:</Category>
  <WebUI>http://[IP]:[PORT:8080]/</WebUI>
  <Icon>https://raw.githubusercontent.com/bordecielnas-alt/Way/main/infra/unraid/icon.png</Icon>
  <Config Name="WebUI" Target="8080" Default="8080" Mode="tcp" Description="Port de l'interface web" Type="Port" Display="always" Required="true" Mask="false">8080</Config>
  <Config Name="Data" Target="/data" Default="/mnt/user/appdata/way" Mode="rw" Description="Base de données et frontières historiques" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/way</Config>
  <Config Name="WAY_CONTACT" Target="WAY_CONTACT" Default="" Mode="" Description="Ton email ou une URL (Wikimedia demande un contact aux clients de ses API)" Type="Variable" Display="always" Required="false" Mask="false"></Config>
</Container>
