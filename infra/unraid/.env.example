# Paste into the stack's ENV file in Docker Compose Manager.

# Required
POSTGRES_PASSWORD=change-me

# Wikimedia asks API clients for a contact in their User-Agent (email or URL).
WAY_CONTACT=

# Web UI port on the Unraid host
WAY_PORT=8088

# Where data lives. Prefer the cache pool path (e.g. /mnt/cache/appdata/way) for Postgres.
APPDATA=/mnt/user/appdata/way

# Image tag: latest, sha-<commit> or a version
WAY_TAG=latest

TZ=Europe/Paris
